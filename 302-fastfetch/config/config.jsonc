// File: /32-fastfetch/config/config.jsonc
// ─────────────────────────────────────────────────────────────────────────────
// 📊 FastFetch
// Settings inspired by:
// - https://github.com/harilvfs/fastfetch/blob/old-days/fastfetch/config.jsonc
// ─────────────────────────────────────────────────────────────────────────────
{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
  "modules": [
    "title",
    {
      "type": "custom",
      "format": "\u001b[90m┌──────────────────────Hardware──────────────────────┐"
    },
    {
      // Shortens e.g. `16-inch` to `16"`, `Thunderbolt 5` to `TB5`
      "type": "command",
      "key": "\uf109 Host",
      "keyColor": "cyan",
      "text": "fastfetch --config none --pipe -l none -s host | sed -e 's/^Host: //' -e 's/-inch/\"/' -e 's/Thunderbolt /TB/'"
    },
    {
      "type": "display",
      "key": "│ ├\udb80\udf79 Display",
      "keyColor": "cyan",
      "format": "{width}x{height}, {scale-factor~0,1}x {inch}\", {refresh-rate} Hz{?is-primary} *{?}"
    },
    {
      "type": "cpu",
      "key": "│ ├\uec19 CPU",
      "keyColor": "cyan"
    },
    {
      "type": "gpu",
      "key": "│ ├\ue266 GPU",
      "keyColor": "cyan"
    },
    {
      "type": "memory",
      "key": "│ ├\uefc5 Memory",
      "keyColor": "cyan"
    },
    {
      "type": "swap",
      "key": "│ ├\udb80\udf5b Swap",
      "keyColor": "cyan"
    },
    {
      "type": "disk",
      "key": "└ └\udb85\udedf Disk",
      "keyColor": "cyan",
      "format": "{size-used} / {size-total} ({size-percentage}) - {filesystem}"
    },
    {
      "type": "custom",
      "format": "\u001b[90m├──────────────────────Software──────────────────────┤"
    },
    {
      "type": "os",
      "key": "\uee9a OS",
      "keyColor": "yellow"
    },
    {
      "type": "kernel",
      "key": "│ ├\ueda7 Kernel",
      "keyColor": "yellow"
    },
    {
      "type": "packages",
      "key": "│ ├\ueb29 Packages",
      "keyColor": "yellow"
    },
    {
      "type": "de",
      "key": "│ ├\udb84\ude39 Desktop Environment",
      "keyColor": "yellow"
    },
    {
      "type": "wm",
      "key": "│ ├\ueb23 Window Manager",
      "keyColor": "yellow",
      "format": "{pretty-name} {version}"
    },
    {
      "type": "command",
      "key": "│ ├\uf197 AeroSpace",
      "keyColor": "yellow",
      "text": "echo $(aerospace --version | head -n 1 | cut -d' ' -f5)"
    },
    {
      "type": "command",
      "key": "│ ├\uf0c9 SketchyBar",
      "keyColor": "yellow",
      "text": "echo $(sketchybar --version | cut -d- -f2)"
    },
    {
      "type": "font",
      "key": "│ ├\ue659 Font",
      "keyColor": "yellow",
      "format": "JetBrains Mono Nerd Fonts"
    },
    {
      "type": "terminaltheme",
      "key": "│ ├\uefcc Theme",
      "keyColor": "yellow",
      "format": "Catppuccin - Macchiato"
    },
    {
      "type": "command",
      "key": "└ └\ueb29 Terminal",
      "keyColor": "yellow",
      "text": "echo \"Alacritty $(alacritty --version | cut -d' ' -f2)\""
    },
    {
      "type": "custom",
      "format": "\u001b[90m├────────────────────────Shell───────────────────────┤"
    },
    {
      "type": "shell",
      "key": "\ue691 Shell",
      "keyColor": "blue"
    },
    {
      "type": "command",
      "key": "│ ├\uebc8 Multiplexer",
      "keyColor": "blue",
      "text": "echo $(tmux -V)"
    },
    {
      "type": "editor",
      "key": "└ └\ue7c5 Editor",
      "keyColor": "blue"
    },
    {
      "type": "custom",
      "format": "\u001b[90m└────────────────────────────────────────────────────┘"
    },
    "break",
    "colors"
  ]
}
