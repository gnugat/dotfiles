{
    "project_panel": {
        "dock": "left"
    },
    "outline_panel": {
        "dock": "left"
    },
    "collaboration_panel": {
        "dock": "left"
    },
    "git_panel": {
        "dock": "left"
    },
    "format_on_save": "off",
    "agent": {
        "dock": "right",
        "tool_permissions": {
            "tools": {
                "terminal": {
                    "default": "allow"
                }
            }
        },
        "default_model": {
            "provider": "copilot_chat",
            "model": "gpt-5.3-codex",
            "enable_thinking": true,
            "effort": "medium"
        },
        "favorite_models": [],
        "model_parameters": []
    },
    "auto_install_extensions": {
        "catppuccin": true,
        "php": true,
        "elm": true
    },
    "theme": "Catppuccin Macchiato",
    "buffer_font_family": "JetBrainsMono Nerd Font",
    "buffer_font_size": 16,
    "vim_mode": true,
    "relative_line_numbers": "enabled",
    "tab_size": 4,
    "languages": {
        "PHP": {
            "language_servers": ["phpactor"]
        }
    }
}
